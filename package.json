{
  "name": "ddd-example",
  "version": "1.0.0",
  "description": "TypeScript + tsoa + InversifyJS + TypeORM によるドメイン駆動設計（DDD）のサンプル実装",
  "keywords": [
    "ddd",
    "domain-driven-design",
    "typescript",
    "tsoa",
    "inversifyjs",
    "typeorm",
    "clean-architecture",
    "express"
  ],
  "license": "MIT",
  "author": "h-iwata (https://github.com/h-iwata)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h-iwata/ts-ddd-example-tsoa-typeorm.git"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsoa spec-and-routes && tsc -p tsconfig.build.json",
    "postbuild": "node -e \"require('node:fs').cpSync('generated/swagger.json', 'dist/generated/swagger.json')\"",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/index.js",
    "dev": "tsoa spec-and-routes && ts-node src/index.ts",
    "tsoa:generate": "tsoa spec-and-routes",
    "watch": "concurrently \"tsoa spec-and-routes -w\" \"ts-node-dev src/index.ts\"",
    "typeorm": "ts-node ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate -d src/infrastructure/database/dataSource.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/infrastructure/database/dataSource.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/infrastructure/database/dataSource.ts",
    "migration:show": "npm run typeorm -- migration:show -d src/infrastructure/database/dataSource.ts",
    "test": "jest --selectProjects unit",
    "test:watch": "jest --selectProjects unit --watch",
    "test:coverage": "jest --selectProjects unit --coverage",
    "test:integration": "NODE_ENV=test jest --selectProjects integration --runInBand",
    "test:all": "NODE_ENV=test jest --runInBand",
    "lint": "biome lint src",
    "lint:fix": "biome lint src --write",
    "format": "biome format src --write",
    "format:check": "biome format src",
    "check": "biome check src",
    "check:fix": "biome check src --write"
  },
  "dependencies": {
    "@tsoa/runtime": "^6.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "inversify": "^7.11.0",
    "mysql2": "^3.24.2",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^10.0.5",
    "fishery": "^2.4.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsoa": "^6.6.0",
    "typescript": "^5.7.3"
  }
}
